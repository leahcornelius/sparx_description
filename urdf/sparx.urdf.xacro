<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sparx">
  <xacro:arg name="use_sim_time" default="false"/>
  <link name="base_footprint"/>
  <link name="base_link"/>
  <link name="head_link"/>
  <link name="laser_frame"/>
  <link name="camera_link"/>

  <!-- Dynamic map->odom and odom->base_footprint are owned by SLAM/odometry. -->
  <xacro:include filename="$(find sparx_description)/urdf/generated_geometry.xacro"/>
</robot>
